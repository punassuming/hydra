# =============================================================================
# Hydra Jobs — environment variable reference
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
# Variables marked [REQUIRED] must be set; all others have safe defaults.
# =============================================================================


# =============================================================================
# SCHEDULER
# =============================================================================

# [REQUIRED] Admin token — grants cross-domain access to /admin/* endpoints.
# Changing this in production invalidates all currently-issued admin sessions.
ADMIN_TOKEN=

# Domain name reserved for admin operations (default: "admin").
# Change only if your tenant namespace uses a different admin domain name.
# ADMIN_DOMAIN=admin

# Credential encryption key — used to encrypt stored credentials (DB URIs,
# PAT tokens, SMTP passwords). Must be a base64-url-encoded 32-byte value.
#
# IMPORTANT: If not set, the key is derived from ADMIN_TOKEN. This means that
# rotating ADMIN_TOKEN will make all stored credentials permanently unreadable.
# Set this to a stable, independently-managed value for production.
#
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# CREDENTIAL_ENCRYPTION_KEY=

# Scheduler Redis auth (global requirepass, not per-domain ACL).
# Leave empty if Redis has no requirepass (the default Docker setup).
# SCHEDULER_REDIS_PASSWORD=

# CORS origins allowed to call the scheduler API (comma-separated or *).
# Required when the UI is served from a different host/port than the API.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# --- External infrastructure (docker-compose.yml) ----------------------------
# Point these at an external Redis/MongoDB instead of the bundled containers.
# The bundled `redis`/`mongo` services in docker-compose.yml then simply go
# unused — run `docker compose up --no-deps scheduler ui` (and the same
# --no-deps pattern on the worker compose files) to skip starting them.
# REDIS_URL=redis://redis:6379/0
# MONGO_URL=mongodb://mongo:27017
# MONGO_DB=hydra_jobs
# SCHEDULER_HEARTBEAT_TTL=10

# --- Host port bindings (docker-compose.yml) ---------------------------------
# Change these to avoid conflicts when running multiple stacks on one host.
# SCHEDULER_PORT=8000
# UI_PORT=5173
# REDIS_PORT=6379
# MONGO_PORT=27017

# First-startup domain seeding (scheduler only).
# On a fresh deployment with an empty database the scheduler seeds one domain.
# Pre-set these so workers can connect immediately on first boot.
# SEED_DOMAIN=prod
# SEED_DOMAIN_TOKEN=<api_token_for_that_domain>
# SEED_DOMAIN_REDIS_PASSWORD=<redis_acl_password_for_that_domain>

# AI features (optional — enables job generation and log analysis).
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Demo/test UI affordances (Load Demo Jobs, executor smoke test, dependency-
# graph demo, admin quick-actions). A UI-declutter switch, not a privilege
# escalation — every action those elements trigger goes through the same
# already-authorized endpoints regardless of this setting. Defaults to
# false in docker-compose.yml, true in the docker-compose.dev.yml overlay;
# off by default in the Helm chart (demoMode.enabled). Leave off/unset in
# production.
# HYDRA_DEMO_MODE=false


# =============================================================================
# WORKER
# =============================================================================

# [REQUIRED] Domain the worker belongs to.
# DOMAIN=prod

# [REQUIRED] Domain API token — obtained from the Admin panel or
#   POST /admin/domains/<domain>/token
# API_TOKEN=

# [REQUIRED when WORKER_REQUIRE_REDIS_ACL=true] Per-domain Redis ACL password.
# Rotate via POST /admin/domains/<domain>/redis_acl/rotate
# REDIS_PASSWORD=

# Redis connection (use REDIS_URL for standalone, or REDIS_SENTINELS for HA).
# REDIS_URL=redis://redis:6379/0
# REDIS_SENTINELS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_DB=0
# REDIS_SOCKET_TIMEOUT=2
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=

# Whether to require Redis ACL credentials (recommended: true).
# Set to false only for local dev environments without ACL configured.
# WORKER_REQUIRE_REDIS_ACL=true

# Unique worker identifier. Defaults to worker-<hostname>.
# Set explicitly when running multiple workers on the same host so they get
# distinct IDs (e.g. WORKER_ID=worker-host-1, WORKER_ID=worker-host-2).
# WORKER_ID=

# Comma-separated affinity tags (used for job routing).
# WORKER_TAGS=linux,gpu,high-mem

# Maximum number of concurrent jobs this worker will accept.
# MAX_CONCURRENCY=2

# Initial worker dispatch state on startup: online | draining | offline
# (the Python worker also accepts the legacy alias "disabled" — see
# worker/config.py / go-worker/internal/config/config.go for exact values).
# WORKER_STATE=online

# Deployment type label shown in the UI.
# DEPLOYMENT_TYPE=standalone

# Comma-separated allowed usernames for job routing (empty = any user).
# ALLOWED_USERS=

# Liveness file the heartbeat loop touches every ~2s, read by each worker
# image's Dockerfile HEALTHCHECK. Only override if bind-mounting a different
# tmpfs/path.
# WORKER_HEARTBEAT_FILE=/tmp/hydra_worker_heartbeat

# Metrics sampling — how often to sample process/memory/load (seconds) and
# how much history to retain (seconds).
# WORKER_METRICS_SAMPLE_SECONDS=15
# WORKER_METRICS_WINDOW_SECONDS=1800


# =============================================================================
# NON-CONTAINERIZED WORKER EXECUTION
# Override these when running workers outside Docker (bare-metal, VMs).
# =============================================================================
# HYDRA_PYTHON_PATH=/opt/python3.11/bin/python3
# HYDRA_SHELL_PATH=/usr/local/bin/bash
# HYDRA_GIT_PATH=/usr/local/bin/git
# HYDRA_TEMP_DIR=/var/tmp/hydra


# =============================================================================
# UI
# =============================================================================

# Base URL of the scheduler API as seen from the BROWSER (not the container).
#
# VITE_API_BASE_URL is baked in at image build time (the fallback if nothing
# else is set). HYDRA_API_BASE_URL overrides it at container START — the
# entrypoint regenerates a small runtime-config.js from it, so the same built
# image can be pointed at different scheduler endpoints without a rebuild.
# docker-compose.yml defaults HYDRA_API_BASE_URL to VITE_API_BASE_URL's value
# so you only need to set one of them for the common case.
# VITE_API_BASE_URL=http://localhost:8000
# HYDRA_API_BASE_URL=http://localhost:8000


# =============================================================================
# MULTIPLE WORKER POOLS (docker-compose.workers.yml)
# =============================================================================
# Runs a Python pool and a Go pool side by side against the same scheduler.
# Falls back to DOMAIN/API_TOKEN above when the pool-specific var is unset.
# See docker-compose.workers.yml for how to add further pools.
# WORKER_PYTHON_DOMAIN=prod
# WORKER_PYTHON_API_TOKEN=
# WORKER_PYTHON_TAGS=batch,data
# WORKER_PYTHON_ALLOWED_USERS=
# WORKER_PYTHON_MAX_CONCURRENCY=4
# WORKER_PYTHON_STATE=online
# WORKER_GO_DOMAIN=prod
# WORKER_GO_API_TOKEN=
# WORKER_GO_TAGS=go,lightweight
# WORKER_GO_ALLOWED_USERS=
# WORKER_GO_MAX_CONCURRENCY=8
# WORKER_GO_STATE=online


# =============================================================================
# MONGODB (scheduler only)
# =============================================================================
# Also honored under "External infrastructure" above for docker-compose.yml —
# this is the reference for the underlying variable, used everywhere else too
# (docker-compose.separated.yml's orchestrator, etc).
# MONGO_URL=mongodb://mongo:27017
# MONGO_DB=hydra_jobs
